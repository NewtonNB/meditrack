{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{js,jsx,ts,tsx,css,scss,json}\"",
        "format:check": "prettier --check \"resources/**/*.{js,jsx,ts,tsx,css,scss,json}\"",
        "lint": "eslint resources/js --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint resources/js --ext .js,.jsx,.ts,.tsx --fix",
        "test:frontend": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:install": "npx playwright install --with-deps",
        "type-check": "tsc --noEmit",
        "quality": "npm run format && npm run lint:fix && npm run type-check"
    },
    "devDependencies": {
        "@babel/plugin-transform-react-jsx": "^7.27.1",
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.1.7",
        "@tailwindcss/forms": "^0.5.3",
        "@vitejs/plugin-react": "^5.0.3",
        "autoprefixer": "^10.4.12",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "prettier": "^3.6.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "tailwindcss": "^3.2.1",
        "vite": "^7.0.4"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "@types/ziggy-js": "^1.3.3",
        "bootstrap-icons": "^1.13.1",
        "lucide-react": "^0.548.0",
        "react-icons": "^5.5.0",
        "react-toastify": "^11.0.5",
        "recharts": "^3.3.0",
        "ziggy-js": "^2.6.0"
    }
}
